{
  "id": "vyltzero-prod-default",
  "name": "vyltzero-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": [
    "vyltzero",
    "prod"
  ],
  "match": {
    "response": {
      "strip_path": false,
      "auto_redirect_https": false,
      "code": 305,
      "allow": true,
      "routing": {
        "mode": "least_conn"
      },
      "is_consul": false,
      "redirect_uri": "85.190.106.88:80",
      "backends": [
        {
          "address": "85.190.106.88:80",
          "weight": 100,
          "label": "vps002-traefik-edge-origin"
        }
      ]
    },
    "rules": {
      "path_key": "starts_with",
      "path": "/",
      "jwt_token_validation": "equals"
    }
  },
  "servers": [
    "host:int.vyltzero.com",
    "host:test.vyltzero.com",
    "host:acc.vyltzero.com",
    "host:app.vyltzero.com"
  ]
}
